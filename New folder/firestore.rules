rules_version = '2';

// -----------------------------------------------------------------------------
// IMPORTANT SECURITY NOTE
// -----------------------------------------------------------------------------
// This CRM currently has no Firebase Authentication.
// The React frontend talks directly to Firestore.
//
// Cloud Functions use the Admin SDK and therefore bypass these rules.
//
// These rules intentionally allow unrestricted access for internal development.
// Before production, replace these with authenticated, role-based rules.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Leads
    // -------------------------------------------------------------------------
    match /leads/{phone} {

      // Lead document
      allow read, write: if true;

      // Opportunities subcollection
      match /opportunities/{opportunityId} {
        allow read, write: if true;
      }
    }

    // -------------------------------------------------------------------------
    // Properties
    // -------------------------------------------------------------------------
    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // Campaigns
    // -------------------------------------------------------------------------
    // Unlike leads/properties above, this is NOT opened up for unrestricted
    // client writes, dev-mode convenience or not. Campaign counters
    // (totalRecipients/queuedCount/sentCount/...) are only ever safe to
    // mutate through the transactional helpers in functions/src/campaigns.js
    // (Cloud Functions use the Admin SDK and bypass these rules entirely), so
    // a stray client-side write here could desync a counter from the
    // recipient docs it's derived from with no way to detect it. Reads are
    // left open so a future dashboard can render campaign/recipient status
    // directly from Firestore, matching how the rest of the CRM works.
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if false;

      match /recipients/{recipientId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // WhatsApp Templates
    // -------------------------------------------------------------------------
    // Same posture as campaigns above: this is a mirror of Meta's approved
    // template catalog, only ever written by syncTemplates.js (Admin SDK,
    // bypasses these rules) so a stray client write can never desync it from
    // what Meta actually has approved. Reads are open so the Templates page
    // and the Campaign-creation template picker can read live via onSnapshot.
    match /whatsappTemplates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Dashboard Metrics
    // -------------------------------------------------------------------------
    // Same posture as campaigns/whatsappTemplates above: `metrics/dashboard`
    // is a set of running counters moved ONLY by FieldValue.increment() calls
    // inside functions/src/metrics.js (Cloud Functions use the Admin SDK and
    // bypass these rules entirely). A stray client write here could desync a
    // counter from the events it's derived from with no way to detect or
    // repair it, so writes are closed. Reads are open so the dashboard can
    // render every counter from a single `get()`/`onSnapshot()` on this one
    // doc, matching how the rest of the CRM already reads live from Firestore.
    match /metrics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Daily / Weekly / Monthly rollups of the same counters as
    // `metrics/dashboard` above (see functions/src/metrics.js's periodRefs/
    // dayKey/isoWeekKey/monthKey) — one doc per calendar day / ISO week /
    // calendar month, same write-closed/read-open posture and same reason.
    match /metricsDaily/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /metricsWeekly/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /metricsMonthly/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Deny everything else
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}