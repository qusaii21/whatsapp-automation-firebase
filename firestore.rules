rules_version = '2';

// -----------------------------------------------------------------------------
// IMPORTANT SECURITY NOTE
// -----------------------------------------------------------------------------
// The project spec explicitly excludes adding an authentication provider, and
// the admin CRM (React app) talks to Firestore directly using the client SDK
// (no server in between for reads/writes made from the browser). Cloud
// Functions always use the Admin SDK, which bypasses these rules entirely, so
// the webhook/agent logic is unaffected by what's below.
//
// Because there is no login/auth in front of the CRM, these rules allow open
// read/write to the two collections so the CRM works as specified. Anyone who
// has the Firebase web config (which is not secret, but IS discoverable) can
// read/write this data. This is acceptable for an internal prototype but is
// NOT safe for a public production deployment. If this ever goes further than
// an internal tool, add Firebase Authentication and tighten these rules to
// `request.auth != null` (or per-role checks) before shipping.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    match /leads/{phone} {
      allow read, write: if true;
    }

    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
